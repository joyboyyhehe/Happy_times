rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Staff (Super Admin / Branch Admin) always sign in with email+password,
    // so their JWT always contains an email claim.
    // Parents use phone OTP (no email claim), so this correctly excludes them.
    function isStaff() {
      return isAuthenticated() && request.auth.token.email != null;
    }

    // Match posts images (school announcements)
    match /posts/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }
    
    // Fallback rule to deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
