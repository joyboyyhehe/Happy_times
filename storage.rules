rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get the user's role from Firestore
    function getUserRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }
    
    // Helper function to check if the user is a staff member (superadmin or branchadmin)
    function isStaff() {
      return isAuthenticated() && (getUserRole() == 'superadmin' || getUserRole() == 'branchadmin');
    }

    // Match posts images (school announcements)
    match /posts/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }
    
    // Fallback rule to deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
